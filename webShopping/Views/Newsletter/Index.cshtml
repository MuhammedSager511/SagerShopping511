@model IEnumerable<webShopping.Models.NewsletterSubscriber>
@{
    ViewData["Title"] = Localizer["Newsletter"];
}
<div class="section-title mb-3"><i class="bi bi-mailbox"></i> @Localizer["Newsletter"]</div>
<div class="admin-table-wrap global-card">
    <table class="table table-hover mb-0 global-table">
        <thead>
            <tr>
                <th>Email</th>
                <th>@Localizer["Date"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Email</td>
                <td>@item.SubscribedAt.ToLocalTime().ToString("g")</td>
                <td class="text-end">
                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('@Localizer["ConfirmDelete"]');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@item.Id" />
                        <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Delete"]</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
