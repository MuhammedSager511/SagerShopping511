@model IEnumerable<ApplicationUser>

@{
    ViewData["Title"] = Localizer["Users"];
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="section-title mb-0"><i class="bi bi-people"></i> @Localizer["Users"]</h2>
    <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-accent">
        <i class="bi bi-person-plus"></i> @Localizer["AddUser"]
    </a>
</div>

<div class="card border-0 shadow-sm" style="border-radius:12px">
    <div class="table-responsive">
        <table class="table table-hover mb-0" id="myTable">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@(item.Name ?? "-") @(item.LastName ?? "")</td>
                        <td>@item.Email</td>
                        <td><span class="badge bg-primary">@(item.Role ?? "User")</span></td>
                        <td class="text-nowrap">
                            <a asp-action="EditRole" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css" />
    <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
    <script>$(function () { $('#myTable').DataTable(); });</script>
}
