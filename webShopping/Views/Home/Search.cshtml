@model IEnumerable<webShopping.Models.Product>

@{
    ViewData["Title"] = Localizer["Search"];
    var query = ViewData["Query"]?.ToString();
    ViewBag.Breadcrumbs = new (string, string?)[] {
        (Localizer["Home"], Url.Action("Index", "Home")),
        (Localizer["Search"], null)
    };
}

<div class="row g-4">
    @await Component.InvokeAsync("CategoryList")
    <div class="col-md-9">
        <div class="section-title">
            <i class="bi bi-search"></i> @Localizer["Search"]
            @if (!string.IsNullOrEmpty(query))
            {
                <small class="text-muted fw-normal">? "@query"</small>
            }
        </div>

        @if (Model.Any())
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <partial name="_ProductCard" model="item" />
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state global-card">
                <i class="bi bi-search"></i>
                <p>@Localizer["NoProducts"]</p>
            </div>
        }
    </div>
</div>
