@page
@using Microsoft.AspNetCore.Http.Features
@model TwoFactorAuthenticationModel
@{
    ViewData["Title"] = Localizer["TwoFactorAuth"];
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h4 class="fw-bold mb-3">@Localizer["TwoFactorAuth"]</h4>
@{
    var consentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
    @if (consentFeature?.CanTrack ?? true)
    {
        @if (Model.Is2faEnabled)
        {
            <p class="text-success"><i class="bi bi-shield-check"></i> 2FA @Localizer["Enabled"]</p>
            <a asp-page="./Disable2fa" class="btn btn-outline-danger me-2">@Localizer["Disable2FA"]</a>
            <a asp-page="./GenerateRecoveryCodes" class="btn btn-outline-secondary">@Localizer["ResetPassword"]</a>
        }
        else
        {
            <p class="text-muted">@Localizer["TwoFactorAuth"]</p>
            <a asp-page="./EnableAuthenticator" class="btn btn-accent">@Localizer["Enable2FA"]</a>
        }
    }
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
