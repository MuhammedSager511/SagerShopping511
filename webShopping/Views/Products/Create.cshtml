@model webShopping.Models.Product

@{
    ViewData["Title"] = Localizer["Create"];
}

<div class="section-title mb-4"><i class="bi bi-plus-circle"></i> @Localizer["Create"] @Localizer["Products"]</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm p-4" style="border-radius:12px">
            <form asp-action="Create" method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Name" class="form-label">@Localizer["Name"] (EN)</label>
                        <input asp-for="Name" class="form-control" required />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="NameAr" class="form-label">@Localizer["NameAr"]</label>
                        <input asp-for="NameAr" class="form-control" dir="rtl" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Price" class="form-label">@Localizer["Price"] (@Localizer["PriceInUsd"])</label>
                        <input asp-for="Price" class="form-control" type="number" step="0.01" min="0.01" required />
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="SalePrice" class="form-label">@Localizer["SalePrice"]</label>
                        <input asp-for="SalePrice" class="form-control" type="number" step="0.01" min="0.01" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="StockQuantity" class="form-label">@Localizer["StockQuantity"]</label>
                        <input asp-for="StockQuantity" class="form-control" type="number" min="0" step="1" value="10" required />
                        <small class="text-muted">@Localizer["StockQuantityHint"]</small>
                        <span asp-validation-for="StockQuantity" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="CategoryId" class="form-label">@Localizer["Categories"]</label>
                        <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId" required>
                            <option value="">-- @Localizer["Categories"] --</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger"></span>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="BrandId" class="form-label">@Localizer["Brands"]</label>
                        <select asp-for="BrandId" class="form-select" asp-items="ViewBag.BrandId">
                            <option value="">--</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Colors" class="form-label">@Localizer["Colors"]</label>
                        <input asp-for="Colors" class="form-control" placeholder="Red,Blue,Black" />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Sizes" class="form-label">@Localizer["Sizes"]</label>
                        <input asp-for="Sizes" class="form-control" placeholder="S,M,L,XL" />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="File" class="form-label">@Localizer["ProductImage"]</label>
                        <input type="file" name="File" class="form-control" accept=".jpeg,.jpg,.png,.gif,.webp" id="mainImageInput" />
                        <small class="text-muted">@Localizer["ImageOptional"]</small>
                        <div class="product-admin-preview-main mt-2 d-none" id="mainImagePreviewWrap">
                            <img id="mainImagePreview" alt="" />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["GalleryImages"]</label>
                        <input type="file" name="galleryFiles" class="form-control" accept=".jpeg,.jpg,.png,.webp" multiple id="galleryImageInput" />
                        <div class="product-admin-gallery mt-2" id="galleryPreview"></div>
                    </div>
                    <div class="col-12">
                        <label asp-for="Description" class="form-label">@Localizer["Description"] (EN)</label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                    <div class="col-12">
                        <label asp-for="DescriptionAr" class="form-label">@Localizer["DescriptionAr"]</label>
                        <textarea asp-for="DescriptionAr" class="form-control" rows="3" dir="rtl"></textarea>
                    </div>
                    <div class="col-md-6">
                        <div class="form-check mt-2">
                            <input class="form-check-input" asp-for="IsHome" />
                            <label class="form-check-label" asp-for="IsHome">@Localizer["FeaturedProducts"]</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-accent btn-action">
                        <i class="bi bi-check-lg"></i> @Localizer["Save"]
                    </button>
                    <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
