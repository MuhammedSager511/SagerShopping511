@page
@model Disable2faModel
@{
    ViewData["Title"] = Localizer["Disable2faTitle"];
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h4 class="fw-bold mb-3">@Localizer["Disable2faTitle"]</h4>
<div class="alert alert-warning">
    <p class="mb-1"><strong>@Localizer["Disable2faWarning"]</strong></p>
    <p class="mb-0 small">@Localizer["Disable2faNote"] <a asp-page="./ResetAuthenticator">@Localizer["ResetAuthenticatorLink"]</a></p>
</div>
<form method="post">
    <button class="btn btn-danger" type="submit">@Localizer["Disable2FA"]</button>
</form>
