@page
@model RegisterModel
@using webShopping.Models
@{
    ViewData["Title"] = Localizer["Register"];
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="auth-card global-card p-4">
            <div class="text-center mb-4">
                <h2 class="fw-bold mb-1">@Localizer["RegisterTitle"]</h2>
                <p class="text-muted small">@Localizer["GlobalStore"]</p>
            </div>

            <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["FirstName"]</label>
                        <input asp-for="Input.Name" class="form-control" />
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["LastName"]</label>
                        <input asp-for="Input.LastName" class="form-control" />
                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["Email"]</label>
                        <input asp-for="Input.Email" class="form-control" />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["Phone"]</label>
                        <input asp-for="Input.TelphonNo" class="form-control" />
                        <span asp-validation-for="Input.TelphonNo" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label class="form-label">@Localizer["Address"]</label>
                        <input asp-for="Input.Addres" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["City"]</label>
                        <input asp-for="Input.City" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["Country"]</label>
                        <input asp-for="Input.Country" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">@Localizer["PostCode"]</label>
                        <input asp-for="Input.PostaKodu" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["Password"]</label>
                        <input asp-for="Input.Password" class="form-control" />
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">@Localizer["ConfirmPassword"]</label>
                        <input asp-for="Input.ConfirmPassword" class="form-control" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
                    </div>
                    @if (User.IsInRole(Diger.Role_Admin))
                    {
                        <div class="col-12">
                            <label class="form-label">@Localizer["Role"]</label>
                            @Html.DropDownListFor(m => m.Input.Role, Model.Input.RoleList, Localizer["Role"], new { @class = "form-select" })
                        </div>
                    }
                </div>
                <button type="submit" class="btn btn-accent w-100 btn-lg mt-4">
                    <i class="bi bi-person-plus"></i> @Localizer["Register"]
                </button>
                <p class="text-center small mt-3 mb-0">
                    <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl">@Localizer["SignIn"]</a>
                </p>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
