@{
    var culture = Localizer.CurrentLanguage;
    var isRtl = Localizer.IsRtl;
    var pageTitle = ViewData["Title"]?.ToString() ?? Localizer["GlobalStore"];
    var metaDescription = ViewData["MetaDescription"]?.ToString() ?? Site.T(Site.Settings.FooterTextEn, Site.Settings.FooterTextAr);
    var canonical = $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var ogLocale = culture switch { "ar" => "ar_SY", "tr" => "tr_TR", _ => "en_US" };
    var brandS = Site.Settings;
    var brandFull = ThemeHelper.FullSiteName(brandS, Localizer.IsArabic);
    var themePrimary = ThemeHelper.NormalizeHex(brandS.ThemePrimary, "#151528");
    var themeAccent = ThemeHelper.NormalizeHex(brandS.ThemeAccent, "#e23b58");
    var themePrimarySoft = ThemeHelper.Lighten(themePrimary, 0.06);
    var themePrimaryDeep = ThemeHelper.Darken(themePrimary, 0.08);
    var themeAccentSoft = ThemeHelper.Lighten(themeAccent, 0.25);
    var brandName = Localizer.IsArabic && !string.IsNullOrWhiteSpace(brandS.SiteNameAr) ? brandS.SiteNameAr : (string.IsNullOrWhiteSpace(brandS.SiteNameEn) ? "Sager" : brandS.SiteNameEn);
    var brandHighlight = Localizer.IsArabic && !string.IsNullOrWhiteSpace(brandS.SiteNameHighlightAr) ? brandS.SiteNameHighlightAr : (string.IsNullOrWhiteSpace(brandS.SiteNameHighlightEn) ? "Shop" : brandS.SiteNameHighlightEn);
    var favicon = !string.IsNullOrWhiteSpace(brandS.LogoPath) ? Url.Content($"~/files/{brandS.LogoPath}") : Url.Content("~/images/image/logo.png");
}
<!DOCTYPE html>
<html lang="@culture" dir="@(isRtl ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover, maximum-scale=5" />
    <meta name="description" content="@metaDescription" />
    <meta name="theme-color" content="@themePrimary" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="@canonical" />
    <meta property="og:title" content="@pageTitle - @brandFull" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@brandFull" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:locale" content="@ogLocale" />
    <link rel="icon" href="@favicon" type="image/png" />
    <link rel="alternate" hreflang="en" href="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}?culture=en")" />
    <link rel="alternate" hreflang="ar" href="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}?culture=ar")" />
    <link rel="alternate" hreflang="tr" href="@($"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}?culture=tr")" />
    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap.xml" />
    <title>@pageTitle - @brandFull</title>
    @await RenderSectionAsync("Meta", required: false)
    <style>
        #site-loader{position:fixed;inset:0;z-index:20000;display:grid;place-items:center;background:linear-gradient(160deg,@themePrimary 0%,@themePrimarySoft 55%,@themePrimaryDeep 100%);transition:opacity .35s ease,visibility .35s ease}
        #site-loader.is-hidden{opacity:0;visibility:hidden;pointer-events:none}
        #site-loader .site-loader-card{text-align:center;color:#fff}
        #site-loader .site-loader-brand{font-family:system-ui,sans-serif;font-weight:800;font-size:1.55rem;letter-spacing:-.04em;margin:0 0 .85rem}
        #site-loader .site-loader-brand span{color:@themeAccent}
        #site-loader .site-loader-ring{width:46px;height:46px;margin:0 auto .7rem;border-radius:50%;border:3px solid rgba(255,255,255,.18);border-top-color:@themeAccent;border-right-color:@themeAccentSoft;animation:siteSpin .75s linear infinite}
        #site-loader .site-loader-text{font-size:.82rem;opacity:.75;margin:0}
        #site-progress{position:fixed;top:0;inset-inline:0;height:3px;z-index:20001;transform-origin:left center;transform:scaleX(0);background:linear-gradient(90deg,@themeAccent,@themeAccentSoft);opacity:0;transition:opacity .2s}
        #site-progress.is-on{opacity:1;animation:siteProgress 1.1s ease-in-out infinite}
        [dir=rtl] #site-progress{transform-origin:right center}
        @@keyframes siteSpin{to{transform:rotate(360deg)}}
        @@keyframes siteProgress{0%{transform:scaleX(.08)}50%{transform:scaleX(.72)}100%{transform:scaleX(.2)}}
        @@media (prefers-reduced-motion:reduce){#site-loader .site-loader-ring,#site-progress.is-on{animation:none}}
    </style>
    @if (isRtl)
    {
        <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet" />
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    }
    else
    {
        <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Outfit:wght@500;700;800&display=swap" rel="stylesheet" />
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    }
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style id="site-theme">:root { @Html.Raw(ThemeHelper.CssVariables(brandS)) }</style>
</head>
<body class="lang-@culture @(ViewData["HomePage"] as bool? == true ? "is-home" : "") @(User.IsInRole(Diger.Role_Admin) ? "is-admin" : "is-store")">
    <div id="site-progress" aria-hidden="true"></div>
    <div id="site-loader" role="status" aria-live="polite" aria-busy="true">
        <div class="site-loader-card">
            <div class="site-loader-brand">@brandName<span>@brandHighlight</span></div>
            <div class="site-loader-ring" aria-hidden="true"></div>
            <p class="site-loader-text">@Localizer["Loading"]</p>
        </div>
    </div>

    <a class="skip-link" href="#main-content">@Localizer["SkipToContent"]</a>
    <header>
        @await Html.PartialAsync("_UserPanel")
        @await Html.PartialAsync("_AdminPanel")
    </header>

    <main id="main-content" class="@(ViewData["HomePage"] as bool? == true ? "home-main" : "py-3")">
        <div class="@(ViewData["HomePage"] as bool? == true ? "home-shell" : "container-fluid px-lg-4")">
            @if (ViewData["HomePage"] as bool? != true)
            {
                @await Html.PartialAsync("_Breadcrumbs")
            }
            @RenderBody()
        </div>
    </main>

    @await Html.PartialAsync("_Footer")

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @await Component.InvokeAsync("NToastNotify")
</body>
</html>
