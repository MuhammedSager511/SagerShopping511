@page
@model AccessDeniedModel
@{
    ViewData["Title"] = Localizer["AccessDeniedTitle"];
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="auth-card global-card p-4 text-center">
            <i class="bi bi-shield-x text-warning fs-1 mb-3"></i>
            <h2 class="fw-bold">@Localizer["AccessDeniedTitle"]</h2>
            <p class="text-muted">@Localizer["AccessDeniedMessage"]</p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-accent">@Localizer["BackHome"]</a>
        </div>
    </div>
</div>
