@model webShopping.Models.ShoppingCartVM

@{
    ViewData["Title"] = Localizer["Cart"];
}

@if (Model.ListCart.Any())
{
    <div class="section-title"><i class="bi bi-cart3"></i> @Localizer["Cart"]</div>
    <div class="cart-table">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>@Localizer["ProductImage"]</th>
                    <th>@Localizer["Name"]</th>
                    <th>@Localizer["Count"]</th>
                    <th>@Localizer["Price"]</th>
                    <th>@Localizer["Total"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.ListCart)
                {
                    <tr>
                        <td>
                            @if (item.Product.Path == null)
                            {
                                <img src="~/images/image/oip.jpg" width="60" height="45" style="object-fit:cover;border-radius:6px" />
                            }
                            else
                            {
                                <img src="~/files/@item.Product.Path" width="60" height="45" style="object-fit:cover;border-radius:6px" />
                            }
                        </td>
                        <td class="fw-semibold">@item.Product.Name</td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Decrease" asp-route-cartId="@item.Id" class="btn btn-outline-danger"><i class="bi bi-dash"></i></a>
                                <span class="btn btn-light disabled">@item.Count</span>
                                <a asp-action="Add" asp-route-cartId="@item.Id" class="btn btn-outline-primary"><i class="bi bi-plus"></i></a>
                                <a asp-action="Remove" asp-route-cartId="@item.Id" class="btn btn-outline-danger"><i class="bi bi-trash"></i></a>
                            </div>
                        </td>
                        <td>@Currency.Format(item.Product.Price)</td>
                        <td class="fw-bold">@Currency.Format(item.Count * item.Product.Price)</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="table-light">
                    <td colspan="4" class="text-end fw-bold fs-5">@Localizer["Total"]</td>
                    <td class="fw-bold fs-5 text-danger">@Currency.Format(Model.OrderHeader.orderTotal)</td>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="row mt-4 g-3">
        <div class="col-md-4">
            <a asp-controller="Home" asp-action="Shop" class="btn btn-outline-secondary form-control">
                <i class="bi bi-arrow-left"></i> @Localizer["ContinueShopping"]
            </a>
        </div>
        <div class="col-md-4"></div>
        <div class="col-md-4">
            <a asp-action="Summary" class="btn btn-accent form-control py-2">
                <i class="bi bi-credit-card"></i> @Localizer["Checkout"]
            </a>
        </div>
    </div>
}
else
{
    <div class="cart-empty">
        <i class="bi bi-cart-x"></i>
        <h4>@Localizer["EmptyCart"]</h4>
        <p class="text-muted">@Localizer["CartEmptyMessage"]</p>
        <a asp-controller="Home" asp-action="Shop" class="btn btn-accent mt-2">
            <i class="bi bi-shop"></i> @Localizer["ShopAll"]
        </a>
    </div>
}
