@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = Localizer["RegisterConfirmationTitle"];
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="auth-card global-card p-4 text-center">
            <h2 class="fw-bold mb-2">@Localizer["RegisterConfirmationTitle"]</h2>
            <p class="text-muted">@Localizer["RegisterConfirmationBody"]</p>
            @if (Model.EmailConfirmationUrl != null)
            {
                <p class="small">@Localizer["DevelopmentModeLink"] <a href="@Model.EmailConfirmationUrl">@Localizer["ConfirmEmailLink"]</a></p>
            }
            <a asp-page="./Login" class="btn btn-accent mt-2">@Localizer["SignIn"]</a>
        </div>
    </div>
</div>
