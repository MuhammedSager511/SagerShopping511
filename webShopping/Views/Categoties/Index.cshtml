@model IEnumerable<webShopping.Models.Categoty>
@{
    ViewData["Title"] = Localizer["Categories"];
    ViewBag.Breadcrumbs = new (string, string?)[] {
        (Localizer["Dashboard"], Url.Action("Index", "Admin")),
        (Localizer["Categories"], null)
    };
}

<div class="section-title mb-3"><i class="bi bi-folder"></i> @Localizer["Categories"]</div>

<p>
    <a asp-action="Create" class="btn btn-accent btn-action">
        <i class="bi bi-plus-lg"></i> @Localizer["AddCategory"]
    </a>
</p>

<div class="admin-table-wrap global-card">
    @if (!Model.Any())
    {
        <div class="empty-state py-4">
            <i class="bi bi-folder-x"></i>
            <p>@Localizer["NoCategories"]</p>
        </div>
    }
    else
    {
        <table class="table table-hover mb-0 global-table">
            <thead>
                <tr>
                    <th>@Localizer["CategoryName"]</th>
                    <th>@Localizer["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="fw-semibold">@item.Name</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-pencil"></i> @Localizer["Edit"]
                            </a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                <i class="bi bi-trash"></i> @Localizer["Delete"]
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
