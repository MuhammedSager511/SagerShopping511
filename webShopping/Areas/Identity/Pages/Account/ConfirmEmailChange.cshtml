@page
@model ConfirmEmailChangeModel
@{
    ViewData["Title"] = Localizer["ConfirmEmailChangeTitle"];
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="auth-card global-card p-4 text-center">
            <h2 class="fw-bold mb-3">@Localizer["ConfirmEmailChangeTitle"]</h2>
            <partial name="_StatusMessage" model="Model.StatusMessage" />
            <a asp-page="./Login" class="btn btn-accent mt-3">@Localizer["SignIn"]</a>
        </div>
    </div>
</div>
