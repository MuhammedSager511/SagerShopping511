@model IEnumerable<webShopping.Models.OrderHeader>
@{
    ViewData["Title"] = Localizer["BacklogOrders"];
    ViewBag.Breadcrumbs = new (string, string?)[] {
        (Localizer["Home"], Url.Action("Index", "Home")),
        (Localizer["Orders"], Url.Action("Index", "Order")),
        (Localizer["BacklogOrders"], null)
    };
}

<div class="section-title mb-3"><i class="bi bi-hourglass-split"></i> @Localizer["BacklogOrders"]</div>
<partial name="_OrderFilterTabs" model='"pending"' />
<partial name="_OrderList" model="Model" />
