@model webShopping.Models.Coupon
@{
    ViewData["Title"] = Localizer["Create"] + " " + Localizer["Coupons"];
    var isEdit = Model.Id > 0;
}
<div class="section-title mb-3">@(isEdit ? Localizer["Edit"] : Localizer["Create"]) @Localizer["Coupons"]</div>
<div class="global-card p-4 col-lg-8">
    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post">
        @Html.AntiForgeryToken()
        @if (isEdit) { <input type="hidden" asp-for="Id" /><input type="hidden" asp-for="UsedCount" /> }
        <div class="row g-3">
            <div class="col-md-4"><label class="form-label">@Localizer["CouponCode"]</label><input asp-for="Code" class="form-control" required /></div>
            <div class="col-md-4"><label class="form-label">Title EN</label><input asp-for="TitleEn" class="form-control" /></div>
            <div class="col-md-4"><label class="form-label">Title AR</label><input asp-for="TitleAr" class="form-control" dir="rtl" /></div>
            <div class="col-md-4"><label class="form-label">@Localizer["Value"]</label><input asp-for="Value" class="form-control" type="number" step="0.01" /></div>
            <div class="col-md-4 form-check align-self-center ms-2"><input asp-for="IsPercent" class="form-check-input" /><label class="form-check-label" asp-for="IsPercent">@Localizer["Percent"]</label></div>
            <div class="col-md-4"><label class="form-label">@Localizer["MinOrder"]</label><input asp-for="MinOrderUsd" class="form-control" type="number" step="0.01" /></div>
            <div class="col-md-4"><label class="form-label">@Localizer["MaxUses"]</label><input asp-for="MaxUses" class="form-control" type="number" /></div>
            <div class="col-md-4"><label class="form-label">@Localizer["StartsAt"]</label><input asp-for="StartsAt" class="form-control" type="datetime-local" /></div>
            <div class="col-md-4"><label class="form-label">@Localizer["EndsAt"]</label><input asp-for="EndsAt" class="form-control" type="datetime-local" /></div>
            <div class="col-12 form-check"><input asp-for="IsActive" class="form-check-input" /><label class="form-check-label" asp-for="IsActive">Active</label></div>
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-accent">@Localizer["Save"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
        </div>
    </form>
</div>
