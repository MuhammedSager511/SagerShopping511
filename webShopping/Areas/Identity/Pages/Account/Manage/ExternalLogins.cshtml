@page
@model ExternalLoginsModel
@{
    ViewData["Title"] = Localizer["ExternalLoginsTitle"];
    ViewData["ActivePage"] = ManageNavPages.ExternalLogins;
}

<h4 class="fw-bold mb-3">@Localizer["ExternalLoginsTitle"]</h4>
<partial name="_StatusMessage" for="StatusMessage" />
@if (Model.CurrentLogins?.Count > 0)
{
    <h6 class="fw-semibold">@Localizer["RegisteredLogins"]</h6>
    <table class="table global-table">
        <tbody>
            @foreach (var login in Model.CurrentLogins)
            {
                <tr>
                    <td>@login.ProviderDisplayName</td>
                    <td>
                        @if (Model.ShowRemoveButton)
                        {
                            <form asp-page-handler="RemoveLogin" method="post" class="d-inline">
                                <input name="LoginProvider" type="hidden" value="@login.LoginProvider" />
                                <input name="ProviderKey" type="hidden" value="@login.ProviderKey" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["RemoveLogin"]</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
@if (Model.OtherLogins?.Count > 0)
{
    <h6 class="fw-semibold mt-4">@Localizer["AddExternalLogin"]</h6>
    <form asp-page-handler="LinkLogin" method="post" class="d-flex flex-wrap gap-2">
        @foreach (var provider in Model.OtherLogins)
        {
            <button type="submit" class="btn btn-outline-primary" name="provider" value="@provider.Name">@provider.DisplayName</button>
        }
    </form>
}
