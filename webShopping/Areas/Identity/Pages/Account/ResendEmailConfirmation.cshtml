@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = Localizer["ResendEmailTitle"];
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="auth-card global-card p-4">
            <h2 class="fw-bold mb-1">@Localizer["ResendEmailTitle"]</h2>
            <p class="text-muted small mb-4">@Localizer["ResendEmailSubtitle"]</p>
            <form method="post">
                <div asp-validation-summary="All" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Input.Email" class="form-label">@Localizer["Email"]</label>
                    <input asp-for="Input.Email" class="form-control" required />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <button type="submit" class="w-100 btn btn-accent">@Localizer["SendVerificationEmail"]</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
