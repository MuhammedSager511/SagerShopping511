@model webShopping.Models.Banner?
@{
    ViewData["Title"] = Localizer["Create"] + " " + Localizer["Banners"];
    var isEdit = Model?.Id > 0;
}
<div class="section-title mb-3">@(isEdit ? Localizer["Edit"] : Localizer["Create"]) @Localizer["Banners"]</div>
<div class="global-card p-4 col-lg-8">
    <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        @if (isEdit) { <input type="hidden" asp-for="Id" /> }
        <div class="row g-3">
            <div class="col-md-6"><label class="form-label">Title EN</label><input asp-for="TitleEn" class="form-control" required /></div>
            <div class="col-md-6"><label class="form-label">Title AR</label><input asp-for="TitleAr" class="form-control" dir="rtl" /></div>
            <div class="col-md-6"><label class="form-label">Subtitle EN</label><input asp-for="SubtitleEn" class="form-control" /></div>
            <div class="col-md-6"><label class="form-label">Subtitle AR</label><input asp-for="SubtitleAr" class="form-control" dir="rtl" /></div>
            <div class="col-md-8"><label class="form-label">Link URL</label><input asp-for="LinkUrl" class="form-control" /></div>
            <div class="col-md-4"><label class="form-label">@Localizer["SortBy"]</label><input asp-for="SortOrder" class="form-control" type="number" /></div>
            <div class="col-12 form-check"><input asp-for="IsActive" class="form-check-input" /><label class="form-check-label" asp-for="IsActive">Active</label></div>
            <div class="col-12"><label class="form-label">Image</label><input type="file" name="Image" class="form-control" accept="image/*" /></div>
            @if (isEdit && !string.IsNullOrEmpty(Model.ImagePath))
            {
                <div class="col-12"><img src="~/files/@Model.ImagePath" style="max-height:120px;object-fit:contain" /></div>
            }
        </div>
        <div class="mt-3">
            <button type="submit" class="btn btn-accent">@Localizer["Save"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
        </div>
    </form>
</div>
