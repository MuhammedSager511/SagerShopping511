@model webShopping.Models.OrderHeader

<div class="global-card p-4 mt-3">
    <h5 class="fw-bold mb-2"><i class="bi bi-check2-square"></i> @Localizer["ConfirmPaymentTitle"]</h5>
    <p class="text-muted small mb-3">@Localizer["ConfirmPaymentNote"]</p>
    <form asp-controller="Order" asp-action="SubmitPayment" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">@Localizer["PaymentBankName"]</label>
                <input name="paymentBankName" class="form-control" placeholder="@Localizer["PaymentBankNamePlaceholder"]" />
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["PaymentReference"]</label>
                <input name="paymentReference" class="form-control" required placeholder="@Localizer["PaymentReferencePlaceholder"]" />
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-accent">
                    <i class="bi bi-send-check"></i> @Localizer["SubmitPaymentConfirmation"]
                </button>
            </div>
        </div>
    </form>
</div>
