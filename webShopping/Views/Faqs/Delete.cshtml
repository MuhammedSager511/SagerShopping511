@model webShopping.Models.FaqItem
@{
    ViewData["Title"] = Localizer["Delete"];
}
<div class="global-card p-4">
    <p>@Localizer["ConfirmDelete"] — @Model.QuestionEn?</p>
    <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">@Localizer["Delete"]</button>
        <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
    </form>
</div>
