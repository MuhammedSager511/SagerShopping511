@page
@model LockoutModel
@{
    ViewData["Title"] = Localizer["LockoutTitle"];
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="auth-card global-card p-4 text-center">
            <i class="bi bi-lock-fill text-danger fs-1 mb-3"></i>
            <h2 class="text-danger fw-bold">@Localizer["LockoutTitle"]</h2>
            <p class="text-muted">@Localizer["LockoutMessage"]</p>
            <a asp-page="./Login" class="btn btn-outline-secondary mt-2">@Localizer["BackToLogin"]</a>
        </div>
    </div>
</div>
