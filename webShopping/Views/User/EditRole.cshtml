@model ApplicationUser
@{
    ViewData["Title"] = Localizer["Users"];
}

<div class="card border-0 shadow-sm" style="border-radius:12px;max-width:480px">
    <div class="card-body">
        <h5 class="fw-bold mb-3">@Localizer["Users"] — @ViewBag.UserEmail</h5>
        <form asp-action="EditRole" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@ViewBag.UserId" />
            <div class="mb-3">
                <label class="form-label">Role</label>
                <select name="role" asp-items="ViewBag.Roles" class="form-select"></select>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-accent">@Localizer["Manage"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Home"]</a>
            </div>
        </form>
    </div>
</div>
