@page
@model EnableAuthenticatorModel
@{
    ViewData["Title"] = Localizer["ConfigureAuthenticator"];
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h4 class="fw-bold mb-3">@Localizer["ConfigureAuthenticator"]</h4>
<p>@Localizer["AuthenticatorSteps"]</p>
<ol class="mb-4">
    <li class="mb-3">
        <p class="mb-2">@Localizer["ScanQrCode"]</p>
        <code class="d-block p-2 bg-light rounded mb-2">@Model.SharedKey</code>
        <div id="qrCode"></div>
        <div id="qrCodeData" data-url="@Model.AuthenticatorUri"></div>
    </li>
    <li>
        <p>@Localizer["EnterVerificationCode"]</p>
        <form id="send-code" method="post" class="row g-3">
            <div class="col-md-6">
                <label asp-for="Input.Code" class="form-label">@Localizer["VerificationCode"]</label>
                <input asp-for="Input.Code" class="form-control" autocomplete="off" />
                <span asp-validation-for="Input.Code" class="text-danger"></span>
            </div>
            <div class="col-12">
                <button type="submit" class="btn btn-accent">@Localizer["Verify"]</button>
            </div>
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        </form>
    </li>
</ol>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
