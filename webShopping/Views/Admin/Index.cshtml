@{
    ViewData["Title"] = Localizer["Dashboard"];
}

<div class="section-title mb-4">
    <i class="bi bi-speedometer2"></i> @Localizer["Dashboard"]
</div>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-radius:12px;border-left:4px solid #e94560!important">
            <div class="card-body">
                <div class="text-muted small">@Localizer["Products"]</div>
                <div class="fs-2 fw-bold">@ViewBag.TotalProducts</div>
                <a asp-controller="Products" asp-action="Index" class="small">@Localizer["Manage"] &rarr;</a>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-radius:12px;border-left:4px solid #40916c!important">
            <div class="card-body">
                <div class="text-muted small">@Localizer["Categories"]</div>
                <div class="fs-2 fw-bold">@ViewBag.TotalCategories</div>
                <a asp-controller="Categoties" asp-action="Index" class="small">@Localizer["Manage"] &rarr;</a>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-radius:12px;border-left:4px solid #1a1a2e!important">
            <div class="card-body">
                <div class="text-muted small">@Localizer["Users"]</div>
                <div class="fs-2 fw-bold">@ViewBag.TotalUsers</div>
                <a asp-controller="User" asp-action="Index" class="small">@Localizer["Manage"] &rarr;</a>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card border-0 shadow-sm h-100" style="border-radius:12px;border-left:4px solid #f5a623!important">
            <div class="card-body">
                <div class="text-muted small">@Localizer["Orders"]</div>
                <div class="fs-2 fw-bold">@ViewBag.TotalOrders</div>
                <a asp-controller="Order" asp-action="Index" class="small">@Localizer["Manage"] &rarr;</a>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm" style="border-radius:12px">
            <div class="card-header bg-white fw-bold">@Localizer["OrderStatus"]</div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="badge bg-warning text-dark">@Localizer["Pending"]</span>
                    <strong>@ViewBag.PendingOrders</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="badge bg-success">@Localizer["Confirmed"]</span>
                    <strong>@ViewBag.ConfirmedOrders</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="badge bg-info text-dark">@Localizer["Shipped"]</span>
                    <strong>@ViewBag.CargoOrders</strong>
                </div>
                <hr />
                <div class="d-flex justify-content-between">
                    <span>@Localizer["Revenue"]</span>
                    <strong class="text-danger">@Currency.Format((double)ViewBag.Revenue)</strong>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card border-0 shadow-sm" style="border-radius:12px">
            <div class="card-header bg-white fw-bold">@Localizer["RecentOrders"]</div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead><tr><th>#</th><th>@Localizer["Users"]</th><th>@Localizer["Orders"]</th><th>@Localizer["Total"]</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var o in (IEnumerable<webShopping.Models.OrderHeader>)ViewBag.RecentOrders)
                        {
                            <tr>
                                <td>@o.Id</td>
                                <td>@(o.ApplicationUser?.Email ?? o.Name)</td>
                                <td><span class="badge bg-secondary">@o.orderStatus</span></td>
                                <td>@Currency.Format(o.orderTotal)</td>
                                <td><a asp-controller="Order" asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm btn-outline-primary">@Localizer["Details"]</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4" style="border-radius:12px">
    <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
        <span><i class="bi bi-trophy"></i> @Localizer["BestSellers"]</span>
        <a asp-controller="Reports" asp-action="Index" class="small">@Localizer["Reports"] &rarr;</a>
    </div>
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead><tr><th>@Localizer["Products"]</th><th>@Localizer["Sold"]</th><th></th></tr></thead>
            <tbody>
                @{
                    var topProducts = ViewBag.TopProducts as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
                }
                @if (!topProducts.Any())
                {
                    <tr><td colspan="3" class="text-muted text-center py-3">@Localizer["NoProducts"]</td></tr>
                }
                else
                {
                    foreach (var row in topProducts)
                    {
                        webShopping.Models.Product? p = row.Product;
                        if (p == null) continue;
                        <tr>
                            <td>@LocalizedContent.ProductName(p, Localizer)</td>
                            <td>@row.Sold</td>
                            <td class="text-end">
                                <a asp-controller="Products" asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">@Localizer["Edit"]</a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card border-0 shadow-sm mb-3" style="border-radius:12px">
    <div class="card-header bg-white fw-bold"><i class="bi bi-shield-check"></i> @Localizer["SystemHealth"]</div>
    <div class="card-body">
        <p class="text-muted small mb-3">@Localizer["BackupExportHint"]</p>
        <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
            <a asp-action="ExportBackup" class="btn btn-accent btn-sm" data-no-loader>
                <i class="bi bi-download"></i> @Localizer["BackupExport"]
            </a>
            <a href="/sitemap.xml" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm" data-no-loader>
                <i class="bi bi-diagram-3"></i> @Localizer["SeoSitemap"]
            </a>
            <a asp-action="Health" class="btn btn-outline-secondary btn-sm" data-no-loader>
                <i class="bi bi-activity"></i> @Localizer["SystemHealth"]
            </a>
        </div>
        <form asp-action="ImportBackup" method="post" enctype="multipart/form-data" class="row g-2 align-items-end"
              onsubmit="return confirm('@Localizer["BackupImportConfirm"]');">
            @Html.AntiForgeryToken()
            <div class="col-md-6">
                <label class="form-label small mb-1">@Localizer["ChooseBackupFile"]</label>
                <input type="file" name="file" class="form-control form-control-sm" accept=".json,application/json" required />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-outline-warning btn-sm">
                    <i class="bi bi-upload"></i> @Localizer["BackupImport"]
                </button>
            </div>
        </form>
        <p class="small text-muted mt-2 mb-0">@Localizer["BackupImportHint"]</p>
        <p class="small text-muted mt-1 mb-0">@Localizer["LastBackupNote"]</p>
    </div>
</div>

<div class="card border-0 shadow-sm" style="border-radius:12px">
    <div class="card-header bg-white fw-bold"><i class="bi bi-exclamation-triangle text-warning"></i> @Localizer["OutOfStock"] (@ViewBag.LowStock)</div>
    <div class="card-body">
        @if ((int)ViewBag.LowStock > 0)
        {
            <a asp-controller="Products" asp-action="Index" class="btn btn-warning btn-sm">@Localizer["Manage"] @Localizer["Products"]</a>
        }
        else
        {
            <span class="text-success"><i class="bi bi-check-circle"></i> @Localizer["InStock"]</span>
        }
    </div>
</div>
