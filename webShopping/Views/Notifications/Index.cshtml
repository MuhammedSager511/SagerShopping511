@model IEnumerable<webShopping.Models.AppNotification>
@{
    ViewData["Title"] = Localizer["Notifications"];
    var isAr = Localizer.IsArabic;
    string Title(webShopping.Models.AppNotification n) => isAr ? n.TitleAr : n.TitleEn;
    string Message(webShopping.Models.AppNotification n) => isAr ? n.MessageAr : n.MessageEn;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <h2 class="mb-0"><i class="bi bi-bell"></i> @Localizer["Notifications"]</h2>
        @if (Model.Any(n => !n.IsRead))
        {
            <form asp-action="MarkAllRead" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-check2-all"></i> @Localizer["MarkAllRead"]
                </button>
            </form>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="global-card text-center py-5 text-muted">
            <i class="bi bi-bell-slash fs-1 d-block mb-3"></i>
            @Localizer["NotificationsEmpty"]
        </div>
    }
    else
    {
        <div class="notification-list">
            @foreach (var n in Model)
            {
                var link = n.LinkUrl ?? "#";
                <div class="global-card notification-card mb-3 @(n.IsRead ? "" : "notification-unread")">
                    <div class="d-flex justify-content-between align-items-start gap-3">
                        <div class="flex-grow-1">
                            <h6 class="mb-1">@Title(n)</h6>
                            <p class="mb-1 text-muted">@Message(n)</p>
                            <small class="text-muted">@n.CreatedAt.ToLocalTime().ToString("f")</small>
                        </div>
                        <div class="d-flex flex-column gap-1 align-items-end">
                            @if (!n.IsRead)
                            {
                                <form asp-action="MarkRead" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@n.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-primary">
                                        @Localizer["MarkAsRead"]
                                    </button>
                                </form>
                            }
                            @if (!string.IsNullOrEmpty(n.LinkUrl))
                            {
                                <a href="@link" class="btn btn-sm btn-link">@Localizer["ViewDetails"]</a>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
