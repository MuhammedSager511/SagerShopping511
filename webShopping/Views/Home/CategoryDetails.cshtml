@model IEnumerable<webShopping.Models.Product>

@{
    ViewData["Title"] = Localizer["Categories"];
}

<div class="row g-4">
    @await Component.InvokeAsync("CategoryList")
    <div class="col-md-9">
        @if (Model.Any())
        {
            <div class="row g-4">
                @foreach (var item in Model)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <partial name="_ProductCard" model="item" />
                    </div>
                }
            </div>
        }
        else
        {
            <div class="alert alert-warning text-center py-4">@Localizer["NoProducts"]</div>
        }
    </div>
</div>
