@page
@model LogoutModel
@{
    ViewData["Title"] = Localizer["LogoutTitle"];
}

<div class="row justify-content-center">
    <div class="col-md-5 text-center">
        <p class="text-muted">@Localizer["LogoutMessage"]</p>
        <form class="d-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
            <button type="submit" class="btn btn-accent">@Localizer["LogoutTitle"]</button>
        </form>
    </div>
</div>
