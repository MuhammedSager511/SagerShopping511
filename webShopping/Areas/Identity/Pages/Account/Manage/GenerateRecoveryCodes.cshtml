@page
@model GenerateRecoveryCodesModel
@{
    ViewData["Title"] = Localizer["GenerateRecoveryCodesTitle"];
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h4 class="fw-bold mb-3">@Localizer["GenerateRecoveryCodesTitle"]</h4>
<div class="alert alert-warning">
    <p class="mb-1"><strong>@Localizer["RecoveryCodesSafe"]</strong></p>
    <p class="mb-0 small">@Localizer["RecoveryCodesWarning"] @Localizer["Disable2faNote"] <a asp-page="./ResetAuthenticator">@Localizer["ResetAuthenticatorLink"]</a></p>
</div>
<form method="post">
    <button class="btn btn-danger" type="submit">@Localizer["GenerateRecoveryCodesBtn"]</button>
</form>
