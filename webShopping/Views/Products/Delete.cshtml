@model webShopping.Models.Product
@{
    ViewData["Title"] = Localizer["Delete"];
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="global-card p-4 border-danger">
            <h4 class="text-danger fw-bold mb-3">@Localizer["ConfirmDelete"]</h4>
            <div class="d-flex gap-3 align-items-start mb-3">
                @if (string.IsNullOrEmpty(Model.Path))
                {
                    <img src="~/images/image/oip.jpg" width="80" height="80" class="rounded" style="object-fit:cover" />
                }
                else
                {
                    <img src="~/files/@Model.Path" width="80" height="80" class="rounded" style="object-fit:cover" />
                }
                <div>
                    <div class="fw-bold fs-5">@Model.Name</div>
                    <div class="text-danger fw-bold">@Currency.Format(Model.Price)</div>
                    <div class="text-muted small">@Model.categoty?.Name</div>
                </div>
            </div>
            <form asp-action="Delete" method="post" class="d-flex gap-2">
                <input type="hidden" asp-for="Id" />
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">@Localizer["Delete"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
            </form>
        </div>
    </div>
</div>
