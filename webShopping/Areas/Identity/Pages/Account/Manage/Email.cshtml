@page
@model EmailModel
@{
    ViewData["Title"] = Localizer["ManageEmail"];
    ViewData["ActivePage"] = ManageNavPages.Email;
}

<h4 class="fw-bold mb-3">@Localizer["ManageEmail"]</h4>
<partial name="_StatusMessage" for="StatusMessage" />
<form id="email-form" method="post">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    @if (Model.IsEmailConfirmed)
    {
        <div class="mb-3">
            <label asp-for="Email" class="form-label">@Localizer["Email"]</label>
            <div class="input-group">
                <input asp-for="Email" class="form-control" disabled />
                <span class="input-group-text text-success">✓ @Localizer["EmailConfirmed"]</span>
            </div>
        </div>
    }
    else
    {
        <div class="mb-3">
            <label asp-for="Email" class="form-label">@Localizer["Email"]</label>
            <input asp-for="Email" class="form-control" disabled />
            <button type="submit" asp-page-handler="SendVerificationEmail" class="btn btn-link px-0">@Localizer["SendVerificationEmail"]</button>
        </div>
    }
    <div class="mb-3">
        <label asp-for="Input.NewEmail" class="form-label">@Localizer["NewEmail"]</label>
        <input asp-for="Input.NewEmail" class="form-control" autocomplete="email" required />
        <span asp-validation-for="Input.NewEmail" class="text-danger"></span>
    </div>
    <button type="submit" asp-page-handler="ChangeEmail" class="btn btn-accent">@Localizer["ChangeEmail"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
