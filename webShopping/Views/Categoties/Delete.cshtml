@model webShopping.Models.Categoty
@{
    ViewData["Title"] = Localizer["Delete"];
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="global-card p-4 border-danger">
            <h4 class="text-danger fw-bold mb-3">@Localizer["ConfirmDelete"]</h4>
            <p class="mb-1"><strong>@Localizer["CategoryName"]:</strong> @Model.Name</p>
            <form asp-action="Delete" method="post" class="mt-4 d-flex gap-2">
                <input type="hidden" asp-for="Id" />
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-danger">@Localizer["Delete"]</button>
                <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
            </form>
        </div>
    </div>
</div>
