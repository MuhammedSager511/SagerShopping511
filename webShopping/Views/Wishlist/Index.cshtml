@model IEnumerable<webShopping.Models.WishlistItem>
@{
    ViewData["Title"] = Localizer["Wishlist"];
    ViewBag.Breadcrumbs = new (string, string?)[] {
        (Localizer["Home"], Url.Action("Index", "Home")),
        (Localizer["Wishlist"], null)
    };
}

<div class="section-title mb-4"><i class="bi bi-heart-fill text-danger"></i> @Localizer["Wishlist"]</div>

@if (!Model.Any())
{
    <div class="empty-state global-card">
        <i class="bi bi-heart"></i>
        <p>@Localizer["WishlistEmpty"]</p>
        <a asp-controller="Home" asp-action="Shop" class="btn btn-accent">@Localizer["ShopAll"]</a>
    </div>
}
else
{
    <p class="text-muted mb-3">@Model.Count() @Localizer["FavoritesCount"]</p>
    <div class="row g-4">
        @foreach (var item in Model)
        {
            @await Html.PartialAsync("_FavoriteCard", item)
        }
    </div>
}
