@model IEnumerable<webShopping.Models.Product>
@inject ISiteContentService Site
@{
    ViewData["Title"] = Localizer["Home"];
    int totalPages = ViewData["TotalPages"] != null ? (int)ViewData["TotalPages"] : 1;
    int currentPage = ViewData["CurrentPage"] != null ? (int)ViewData["CurrentPage"] : 1;
    var s = Site.Settings;
}

<div class="hero-banner">
    <h1>@Site.T(s.HeroTitleEn, s.HeroTitleAr)</h1>
    <p>@Site.T(s.HeroSubtitleEn, s.HeroSubtitleAr)</p>
    <div class="trust-badges">
        <div class="trust-badge"><i class="bi bi-truck"></i> @Localizer["FreeShipping"]</div>
        <div class="trust-badge"><i class="bi bi-shield-lock"></i> @Localizer["SecurePayment"]</div>
        <div class="trust-badge"><i class="bi bi-headset"></i> @Localizer["Support247"]</div>
    </div>
    <a asp-action="Shop" class="btn btn-accent mt-3 px-4 py-2">
        <i class="bi bi-shop"></i> @Localizer["ShopAll"]
    </a>
</div>

<div class="section-title">
    <i class="bi bi-stars text-warning"></i> @Localizer["FeaturedProducts"]
</div>

<div class="row g-4">
    @foreach (var item in Model)
    {
        <div class="col-6 col-md-4 col-lg-3">
            <partial name="_ProductCard" model="item" />
        </div>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info text-center mt-3">@Localizer["NoProducts"]</div>
}

@if (totalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            @if (currentPage > 1)
            {
                <li class="page-item"><a class="page-link" href="?page=@(currentPage - 1)">&laquo;</a></li>
            }
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" href="?page=@i">@i</a>
                </li>
            }
            @if (currentPage < totalPages)
            {
                <li class="page-item"><a class="page-link" href="?page=@(currentPage + 1)">&raquo;</a></li>
            }
        </ul>
    </nav>
}
