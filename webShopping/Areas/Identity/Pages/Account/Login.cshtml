@page
@model LoginModel
@{
    ViewData["Title"] = Localizer["Login"];
}

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <div class="auth-card global-card p-4">
            <div class="text-center mb-4">
                <img src="~/images/image/logo.png" width="48" height="48" alt="SagerShop" class="mb-2" />
                <h2 class="fw-bold mb-1">@Localizer["LoginTitle"]</h2>
                <p class="text-muted small mb-0">@Localizer["GlobalStore"]</p>
            </div>

            @if ((Model.ExternalLogins?.Count ?? 0) > 0)
            {
                <p class="text-center text-muted small">@Localizer["OrContinueWith"]</p>
                <form asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post" class="d-flex gap-2 justify-content-center mb-3">
                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        <button type="submit" class="btn btn-outline-secondary auth-social-btn" name="provider" value="@provider.Name" title="@provider.DisplayName">
                            @if (provider.Name == "Facebook")
                            {
                                <img src="~/images/image/fe.png" width="22" height="22" alt="Facebook" />
                            }
                            else if (provider.Name == "Google")
                            {
                                <img src="~/images/image/google.png" width="22" height="22" alt="Google" />
                            }
                        </button>
                    }
                </form>
                <hr />
            }

            <form id="account" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-2" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Email" class="form-control" autocomplete="username" placeholder="@Localizer["Email"]" />
                    <label asp-for="Input.Email">@Localizer["Email"]</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" placeholder="@Localizer["Password"]" />
                    <label asp-for="Input.Password">@Localizer["Password"]</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label class="form-check-label" asp-for="Input.RememberMe">@Localizer["RememberMe"]</label>
                </div>
                <button type="submit" class="btn btn-accent w-100 btn-lg mb-3">
                    <i class="bi bi-box-arrow-in-right"></i> @Localizer["SignIn"]
                </button>
                <div class="text-center small">
                    <a asp-page="./ForgotPassword">@Localizer["ForgotPassword"]</a>
                    <span class="mx-1">·</span>
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">@Localizer["SignUp"]</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
