@page
@model ErrorModel
@{
    ViewData["Title"] = Localizer["IdentityErrorTitle"];
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="global-card p-4 text-center">
            <h2 class="text-danger fw-bold">@Localizer["IdentityErrorTitle"]</h2>
            <p class="text-muted">@Localizer["IdentityErrorMessage"]</p>
            @if (Model.ShowRequestId)
            {
                <p class="small text-muted"><code>@Model.RequestId</code></p>
            }
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">@Localizer["BackHome"]</a>
        </div>
    </div>
</div>
