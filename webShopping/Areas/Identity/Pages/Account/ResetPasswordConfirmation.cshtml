@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = Localizer["ResetPasswordConfirmationTitle"];
}

<div class="row justify-content-center">
    <div class="col-md-5">
        <div class="auth-card global-card p-4 text-center">
            <i class="bi bi-check-circle text-success fs-1 mb-3"></i>
            <h2 class="fw-bold">@Localizer["ResetPasswordConfirmationTitle"]</h2>
            <p class="text-muted">@Localizer["ResetPasswordConfirmationBody"]</p>
            <a asp-page="./Login" class="btn btn-accent">@Localizer["SignIn"]</a>
        </div>
    </div>
</div>
