@model IEnumerable<webShopping.Models.OrderHeader>
@{
    ViewData["Title"] = Localizer["Orders"];
    ViewBag.Breadcrumbs = new (string, string?)[] {
        (Localizer["Home"], Url.Action("Index", "Home")),
        (Localizer["Orders"], null)
    };
}

<div class="section-title mb-3"><i class="bi bi-bag-check"></i> @Localizer["Orders"]</div>
<partial name="_OrderFilterTabs" model='"all"' />
<partial name="_OrderList" model="Model" />
