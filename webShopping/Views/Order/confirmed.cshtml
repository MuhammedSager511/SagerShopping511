@model IEnumerable<webShopping.Models.OrderHeader>
@{
    ViewData["Title"] = Localizer["ConfirmedOrders"];
    ViewBag.Breadcrumbs = new (string, string?)[] {
        (Localizer["Home"], Url.Action("Index", "Home")),
        (Localizer["Orders"], Url.Action("Index", "Order")),
        (Localizer["ConfirmedOrders"], null)
    };
}

<div class="section-title mb-3"><i class="bi bi-check-circle"></i> @Localizer["ConfirmedOrders"]</div>
<partial name="_OrderFilterTabs" model='"confirmed"' />
<partial name="_OrderList" model="Model" />
