@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = Localizer["DeletePersonalDataTitle"];
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h4 class="fw-bold mb-3">@Localizer["DeletePersonalDataTitle"]</h4>
<div class="alert alert-warning"><strong>@Localizer["PersonalDataDeleteWarning"]</strong></div>
<form id="delete-user" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    @if (Model.RequirePassword)
    {
        <div class="mb-3">
            <label asp-for="Input.Password" class="form-label">@Localizer["OldPassword"]</label>
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
    }
    <button class="btn btn-danger" type="submit">@Localizer["ConfirmDeleteAccount"]</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
