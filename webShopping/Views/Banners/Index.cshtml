@model IEnumerable<webShopping.Models.Banner>
@{
    ViewData["Title"] = Localizer["Banners"];
}
<div class="section-title mb-3"><i class="bi bi-images"></i> @Localizer["Banners"]</div>
<p><a asp-action="Create" class="btn btn-accent btn-action"><i class="bi bi-plus-lg"></i> @Localizer["Create"]</a></p>
<div class="admin-table-wrap global-card">
    <table class="table table-hover mb-0 global-table">
        <thead><tr><th></th><th>@Localizer["Name"]</th><th>@Localizer["SortBy"]</th><th></th></tr></thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@if (!string.IsNullOrEmpty(item.ImagePath)) { <img src="~/files/@item.ImagePath" width="64" height="36" class="rounded" style="object-fit:cover" /> }</td>
                <td>@item.TitleEn @(item.IsActive ? "" : "(off)")</td>
                <td>@item.SortOrder</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">@Localizer["Edit"]</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">@Localizer["Delete"]</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
