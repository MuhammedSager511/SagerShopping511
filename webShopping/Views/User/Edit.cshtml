@model ApplicationUser
@{
    ViewData["Title"] = Localizer["Edit"] + " " + Localizer["Users"];
}
<div class="section-title mb-3"><i class="bi bi-person-gear"></i> @Localizer["Edit"]</div>
<div class="global-card p-4 col-lg-8">
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">@Localizer["FirstName"]</label>
                <input asp-for="Name" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["LastName"]</label>
                <input asp-for="LastName" class="form-control" />
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Email"]</label>
                <input asp-for="Email" class="form-control" readonly disabled />
            </div>
            <div class="col-md-6">
                <label class="form-label">@Localizer["Phone"]</label>
                <input asp-for="PhoneNumber" class="form-control" />
            </div>
            <div class="col-12">
                <label class="form-label">@Localizer["Address"]</label>
                <input asp-for="Addres" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">@Localizer["City"]</label>
                <input asp-for="City" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">@Localizer["Country"]</label>
                <input asp-for="Country" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label">@Localizer["PostCode"]</label>
                <input asp-for="PostaKodu" class="form-control" />
            </div>
        </div>
        <div class="mt-3 d-flex gap-2">
            <button type="submit" class="btn btn-accent">@Localizer["Save"]</button>
            <a asp-action="Index" class="btn btn-outline-secondary">@Localizer["Cancel"]</a>
        </div>
    </form>
</div>
