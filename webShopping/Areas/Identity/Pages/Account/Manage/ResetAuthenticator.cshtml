@page
@model ResetAuthenticatorModel
@{
    ViewData["Title"] = Localizer["ResetAuthenticatorTitle"];
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h4 class="fw-bold mb-3">@Localizer["ResetAuthenticatorTitle"]</h4>
<div class="alert alert-warning">
    <p class="mb-1"><strong>@Localizer["ResetAuthenticatorWarning"]</strong></p>
    <p class="mb-0 small">@Localizer["ResetAuthenticatorNote"]</p>
</div>
<form method="post">
    <button class="btn btn-danger" type="submit">@Localizer["ResetAuthenticatorBtn"]</button>
</form>
