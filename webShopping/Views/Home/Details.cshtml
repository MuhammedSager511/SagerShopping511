@model webShopping.Models.ShoppingCart
@using System.Text.Json

@{
    var product = Model.Product;
    if (product == null)
    {
        <div class="empty-state global-card p-5 text-center">
            <p>@Localizer["ToastProductUnavailable"]</p>
            <a asp-action="Shop" class="btn btn-accent">@Localizer["ShopAll"]</a>
        </div>
        return;
    }
    var name = LocalizedContent.ProductName(product, Localizer);
    var desc = LocalizedContent.ProductDescription(product, Localizer);
    ViewData["Title"] = name;
    var reviews = ViewBag.Reviews as IEnumerable<webShopping.Models.ProductReview> ?? Enumerable.Empty<webShopping.Models.ProductReview>();
    var avgRating = (double)(ViewBag.AvgRating ?? 0d);
    var images = product.Images?.OrderBy(i => i.SortOrder).ToList() ?? new List<webShopping.Models.ProductImage>();
    var schema = new Dictionary<string, object?>
    {
        ["@context"] = "https://schema.org",
        ["@type"] = "Product",
        ["name"] = name,
        ["description"] = desc,
        ["image"] = product.Path != null ? $"{Context.Request.Scheme}://{Context.Request.Host}/files/{product.Path}" : null,
        ["offers"] = new Dictionary<string, object>
        {
            ["@type"] = "Offer",
            ["priceCurrency"] = "USD",
            ["price"] = product.Price.ToString("F2", System.Globalization.CultureInfo.InvariantCulture),
            ["availability"] = product.StockQuantity > 0 ? "https://schema.org/InStock" : "https://schema.org/OutOfStock"
        }
    };
    if (reviews.Any())
    {
        schema["aggregateRating"] = new Dictionary<string, object>
        {
            ["@type"] = "AggregateRating",
            ["ratingValue"] = avgRating.ToString("F1", System.Globalization.CultureInfo.InvariantCulture),
            ["reviewCount"] = reviews.Count()
        };
    }
}

@section Meta {
    <script type="application/ld+json">@Html.Raw(JsonSerializer.Serialize(schema))</script>
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="card border-0 shadow-sm global-card">
            <div class="row g-0">
                <div class="col-md-5">
                    @{
                        var gallerySources = new List<string>();
                        if (!string.IsNullOrEmpty(product.Path))
                            gallerySources.Add(Url.Content($"~/files/{product.Path}"));
                        foreach (var img in images)
                        {
                            var src = Url.Content($"~/files/{img.Path}");
                            if (!gallerySources.Contains(src, StringComparer.OrdinalIgnoreCase))
                                gallerySources.Add(src);
                        }
                        if (gallerySources.Count == 0)
                            gallerySources.Add(Url.Content("~/images/image/oip.jpg"));
                    }
                    <div class="product-gallery" data-product-gallery>
                        <div class="product-gallery-main">
                            <img src="@gallerySources[0]" alt="@name" id="productMainImage" loading="eager" />
                        </div>
                        @if (gallerySources.Count > 1)
                        {
                            <div class="product-gallery-thumbs" role="list">
                                @for (var i = 0; i < gallerySources.Count; i++)
                                {
                                    <button type="button"
                                            class="product-gallery-thumb @(i == 0 ? "is-active" : "")"
                                            data-src="@gallerySources[i]"
                                            aria-label="@Localizer["ProductImage"] @(i + 1)">
                                        <img src="@gallerySources[i]" alt="" loading="lazy" />
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
                    <div class="col-md-7 product-detail-info">
                        @if (product.categoty != null)
                        {
                            <span class="badge bg-secondary mb-2">@LocalizedContent.CategoryName(product.categoty, Localizer)</span>
                        }
                        <h2 class="fw-bold mb-2 product-detail-title">@name</h2>
                        @if (reviews.Any())
                        {
                            <div class="mb-2 text-warning">
                                @for (var s = 1; s <= 5; s++)
                                {
                                    <i class="bi @(s <= Math.Round(avgRating) ? "bi-star-fill" : "bi-star")"></i>
                                }
                                <small class="text-muted ms-1">(@reviews.Count() @Localizer["Reviews"])</small>
                            </div>
                        }
                        <div class="mb-3">
                            <span class="stock-badge @StockHelper.BadgeCss(StockHelper.GetLevel(product))">
                                @StockHelper.Label(product, Localizer)
                            </span>
                        </div>
                        <p class="text-muted">@desc</p>
                        <div class="product-price fs-2 mb-1">
                            @if (PriceHelper.HasDiscount(product))
                            {
                                <span class="product-price-old fs-5">@Currency.Format(product.Price)</span>
                                <span class="badge bg-danger ms-1">-@PriceHelper.DiscountPercent(product)%</span>
                            }
                            @Currency.Format(PriceHelper.EffectiveUnitPrice(product))
                        </div>
                        <small class="text-muted d-block mb-3">@Localizer["StoredInUsd"]: $@PriceHelper.EffectiveUnitPrice(product).ToString("N2")</small>

                        @if (!string.IsNullOrWhiteSpace(product.Colors))
                        {
                            <div class="mb-2"><strong>@Localizer["Colors"]:</strong>
                                @foreach (var c in product.Colors.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                {
                                    <span class="badge bg-secondary me-1">@c</span>
                                }
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(product.Sizes))
                        {
                            <div class="mb-3"><strong>@Localizer["Sizes"]:</strong>
                                @foreach (var s in product.Sizes.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                {
                                    <span class="badge bg-light text-dark border me-1">@s</span>
                                }
                            </div>
                        }

                        <div class="product-detail-actions">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form method="post" asp-action="Details" asp-route-id="@product.Id" class="product-buy-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="ProductId" value="@product.Id" />
                                    <div class="product-qty-field">
                                        <label class="form-label fw-semibold mb-1">@Localizer["Quantity"]</label>
                                        <input name="Count" type="number" min="1" max="@Math.Max(1, product.StockQuantity)" value="1" class="form-control product-qty-input" required @(product.StockQuantity <= 0 ? "disabled" : null) />
                                    </div>
                                    @if (product.StockQuantity > 0)
                                    {
                                        <button type="submit" class="btn btn-accent">
                                            <i class="bi bi-cart-plus"></i> @Localizer["AddToCart"]
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-secondary" disabled>@Localizer["OutOfStock"]</button>
                                    }
                                </form>
                                <form asp-controller="Wishlist" asp-action="Toggle" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <button type="submit" class="btn btn-outline-danger w-100"><i class="bi bi-heart-fill"></i> @Localizer["Wishlist"]</button>
                                </form>
                            }
                            else
                            {
                                <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Context.Request.Path" class="btn btn-accent">
                                    <i class="bi bi-box-arrow-in-right"></i> @Localizer["SignInToBuy"]
                                </a>
                            }
                            <a asp-action="Shop" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> @Localizer["Shop"]</a>
                        </div>
                    </div>
                </div>
            </div>

        @if (User.Identity?.IsAuthenticated == true)
        {
            <div class="global-card p-4 mt-4">
                <h5 class="fw-bold mb-3">@Localizer["WriteReview"]</h5>
                <form asp-action="AddReview" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@product.Id" />
                    <div class="row g-3">
                        <div class="col-md-2">
                            <label class="form-label">@Localizer["Rating"]</label>
                            <select name="rating" class="form-select" required>
                                @for (var r = 5; r >= 1; r--)
                                {
                                    <option value="@r">@r ★</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">@Localizer["Comment"]</label>
                            <input name="comment" class="form-control" required maxlength="500" />
                        </div>
                        <div class="col-md-2 d-flex align-items-end">
                            <button type="submit" class="btn btn-accent w-100">@Localizer["SubmitReview"]</button>
                        </div>
                    </div>
                </form>
            </div>
        }

        @if (reviews.Any())
        {
            <div class="global-card p-4 mt-4">
                <h5 class="fw-bold mb-3">@Localizer["CustomerReviews"]</h5>
                @foreach (var review in reviews)
                {
                    <div class="border-bottom pb-3 mb-3">
                        <div class="text-warning">
                            @for (var s = 1; s <= 5; s++)
                            {
                                <i class="bi @(s <= review.Rating ? "bi-star-fill" : "bi-star")"></i>
                            }
                        </div>
                        <strong>@review.UserName</strong>
                        <small class="text-muted ms-2">@review.CreatedAt.ToString("dd/MM/yyyy")</small>
                        <p class="mb-0 mt-1">@review.Comment</p>
                    </div>
                }
            </div>
        }

        @{
            var similar = ViewBag.Similar as IEnumerable<webShopping.Models.Product> ?? Enumerable.Empty<webShopping.Models.Product>();
        }
        @if (similar.Any())
        {
            <div class="mt-4">
                <h5 class="fw-bold mb-3">@Localizer["SimilarProducts"]</h5>
                <div class="row g-3">
                    @foreach (var item in similar)
                    {
                        <div class="col-6 col-md-3">
                            <partial name="_ProductCard" model="item" />
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>
