@page
@model ShowRecoveryCodesModel
@{
    ViewData["Title"] = Localizer["RecoveryCodesTitle"];
    ViewData["ActivePage"] = ManageNavPages.TwoFactorAuthentication;
}

<partial name="_StatusMessage" for="StatusMessage" />
<h4 class="fw-bold mb-3">@Localizer["RecoveryCodesTitle"]</h4>
<div class="alert alert-warning">
    <p class="mb-1"><strong>@Localizer["RecoveryCodesSafe"]</strong></p>
    <p class="mb-0 small">@Localizer["RecoveryCodesWarning"]</p>
</div>
<div class="bg-light rounded p-3">
    @for (var row = 0; row < Model.RecoveryCodes.Length; row += 2)
    {
        <code class="recovery-code d-inline-block me-2 mb-2">@Model.RecoveryCodes[row]</code>
        @if (row + 1 < Model.RecoveryCodes.Length)
        {
            <code class="recovery-code d-inline-block me-2 mb-2">@Model.RecoveryCodes[row + 1]</code>
        }
        <br />
    }
</div>
