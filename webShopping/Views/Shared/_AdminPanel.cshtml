@using webShopping.Models

@if (User.IsInRole(Diger.Role_Admin))
{
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var isAr = Localizer.IsArabic;

    <div class="lang-currency-bar">
        <div class="container-fluid px-lg-4 d-flex justify-content-between align-items-center">
            <div class="lang-toggle">
                <a asp-controller="Culture" asp-action="SetLanguage" asp-route-culture="en" asp-route-returnUrl="@returnUrl"
                   class="lang-btn @(isAr ? "" : "active")" title="English">
                    <img src="~/images/flags/gb.svg" alt="English" class="flag-icon" />
                </a>
                <a asp-controller="Culture" asp-action="SetLanguage" asp-route-culture="ar" asp-route-returnUrl="@returnUrl"
                   class="lang-btn @(isAr ? "active" : "")" title="العربية">
                    <img src="~/images/flags/sy.svg" alt="العربية" class="flag-icon" />
                </a>
            </div>
            <form asp-controller="Culture" asp-action="SetCurrency" method="post" class="d-flex align-items-center gap-2">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@returnUrl" />
                <select name="currency" class="currency-select" onchange="this.form.submit()">
                    @foreach (var c in Currency.GetSupportedCurrencies())
                    {
                        if (Currency.CurrentCurrency == c.Code)
                        {
                            <option value="@c.Code" selected>@c.Code</option>
                        }
                        else
                        {
                            <option value="@c.Code">@c.Code</option>
                        }
                    }
                </select>
            </form>
        </div>
    </div>

    <nav class="admin-navbar navbar navbar-expand-sm mb-3">
        <div class="container-fluid px-lg-4">
            <a class="text-white fw-bold me-3 text-decoration-none" asp-controller="Admin" asp-action="Index">
                <i class="bi bi-speedometer2"></i> @Localizer["Dashboard"]
            </a>
            <ul class="navbar-nav flex-row flex-wrap gap-1">
                <li class="nav-item"><a class="nav-link" asp-controller="ShippingAdmin" asp-action="Index"><i class="bi bi-truck"></i> @Localizer["ShippingAdmin"]</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="SiteSettings" asp-action="Index"><i class="bi bi-gear"></i> @Localizer["SiteSettings"]</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Categoties" asp-action="Index"><i class="bi bi-folder"></i> @Localizer["Categories"]</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index"><i class="bi bi-box-seam"></i> @Localizer["Products"]</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="User" asp-action="Index"><i class="bi bi-people"></i> @Localizer["Users"]</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Order" asp-action="Index"><i class="bi bi-basket"></i> @Localizer["Orders"]</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Reviews" asp-action="Index"><i class="bi bi-star"></i> @Localizer["ReviewsAdmin"]</a></li>
                <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Shop"><i class="bi bi-shop"></i> @Localizer["Shop"]</a></li>
            </ul>
            <div class="d-flex align-items-center gap-2 ms-auto">
                @await Component.InvokeAsync("NotificationBell")
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>
}
