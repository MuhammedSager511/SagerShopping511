@page
@model ExternalLoginModel
@{
    ViewData["Title"] = Localizer["Register"];
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="auth-card global-card p-4">
            <h2 class="fw-bold mb-1">@Localizer["ExternalLoginTitle"]</h2>
            <p class="text-muted small mb-4">@Localizer["ExternalLoginSubtitle"] <strong>@Model.ProviderDisplayName</strong></p>
            <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="row g-3">
                    <div class="col-md-6">
                        <label asp-for="Input.Name" class="form-label">@Localizer["FirstName"]</label>
                        <input asp-for="Input.Name" class="form-control" required />
                        <span asp-validation-for="Input.Name" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.LastName" class="form-label">@Localizer["LastName"]</label>
                        <input asp-for="Input.LastName" class="form-control" required />
                        <span asp-validation-for="Input.LastName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.Email" class="form-label">@Localizer["Email"]</label>
                        <input asp-for="Input.Email" class="form-control" required />
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.TelphonNo" class="form-label">@Localizer["Phone"]</label>
                        <input asp-for="Input.TelphonNo" class="form-control" required />
                        <span asp-validation-for="Input.TelphonNo" class="text-danger"></span>
                    </div>
                    <div class="col-12">
                        <label asp-for="Input.Addres" class="form-label">@Localizer["Address"]</label>
                        <input asp-for="Input.Addres" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.City" class="form-label">@Localizer["City"]</label>
                        <input asp-for="Input.City" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.Country" class="form-label">@Localizer["Country"]</label>
                        <input asp-for="Input.Country" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Input.PostaKodu" class="form-label">@Localizer["PostCode"]</label>
                        <input asp-for="Input.PostaKodu" class="form-control" />
                    </div>
                </div>
                <button type="submit" class="w-100 btn btn-accent btn-lg mt-4">@Localizer["Register"]</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
