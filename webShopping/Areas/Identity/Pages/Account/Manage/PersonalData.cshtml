@page
@model PersonalDataModel
@{
    ViewData["Title"] = Localizer["PersonalData"];
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<h4 class="fw-bold mb-3">@Localizer["PersonalData"]</h4>
<p>@Localizer["PersonalDataDesc"]</p>
<p><strong>@Localizer["PersonalDataDeleteWarning"]</strong></p>
<form id="download-data" asp-page="DownloadPersonalData" method="post" class="mb-3">
    <button class="btn btn-outline-primary" type="submit"><i class="bi bi-download"></i> @Localizer["DownloadData"]</button>
</form>
<a asp-page="DeletePersonalData" class="btn btn-outline-danger"><i class="bi bi-trash"></i> @Localizer["DeleteAccount"]</a>
