@model IEnumerable<webShopping.Models.Coupon>
@{
    ViewData["Title"] = Localizer["Coupons"];
}
<div class="section-title mb-3"><i class="bi bi-ticket-perforated"></i> @Localizer["Coupons"]</div>
<p><a asp-action="Create" class="btn btn-accent btn-action"><i class="bi bi-plus-lg"></i> @Localizer["Create"]</a></p>
<div class="admin-table-wrap global-card">
    <table class="table table-hover mb-0 global-table">
        <thead>
            <tr>
                <th>@Localizer["CouponCode"]</th>
                <th>@Localizer["Value"]</th>
                <th>@Localizer["Uses"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td><code>@item.Code</code> @item.TitleEn</td>
                <td>@(item.IsPercent ? $"{item.Value}%" : $"{item.Value:N2} USD")</td>
                <td>@item.UsedCount / @(item.MaxUses > 0 ? item.MaxUses.ToString() : "∞")</td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">@Localizer["Edit"]</a>
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">@Localizer["Delete"]</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
