@inject ISiteContentService Site
@{
    ViewData["Title"] = Site.T(Site.Settings.AboutTitleEn, Site.Settings.AboutTitleAr);
    var s = Site.Settings;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm p-4 p-md-5" style="border-radius:12px">
            <h1 class="fw-bold mb-4 text-center">@Site.T(s.AboutTitleEn, s.AboutTitleAr)</h1>
            <div class="about-body" style="line-height:1.9;font-size:1.05rem">
                @Html.Raw(Site.T(s.AboutBodyEn, s.AboutBodyAr).Replace("\n", "<br/>"))
            </div>
            <hr class="my-4" />
            <div class="row g-3 text-center">
                <div class="col-md-4">
                    <i class="bi bi-truck fs-2 text-danger"></i>
                    <p class="mt-2 mb-0 fw-semibold">@Localizer["FreeShipping"]</p>
                </div>
                <div class="col-md-4">
                    <i class="bi bi-shield-lock fs-2 text-danger"></i>
                    <p class="mt-2 mb-0 fw-semibold">@Localizer["SecurePayment"]</p>
                </div>
                <div class="col-md-4">
                    <i class="bi bi-headset fs-2 text-danger"></i>
                    <p class="mt-2 mb-0 fw-semibold">@Localizer["Support247"]</p>
                </div>
            </div>
        </div>
    </div>
</div>
