@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = Localizer["ForgotPasswordConfirmationTitle"];
}

<div class="row justify-content-center">
    <div class="col-md-5 col-lg-4">
        <div class="auth-card global-card p-4 text-center">
            <i class="bi bi-envelope-check text-success fs-1 mb-3"></i>
            <h2 class="fw-bold mb-2">@Localizer["ForgotPasswordConfirmationTitle"]</h2>
            <p class="text-muted">@Localizer["ForgotPasswordConfirmationBody"]</p>
            <a asp-page="./Login" class="btn btn-accent mt-2">@Localizer["BackToLogin"]</a>
        </div>
    </div>
</div>
