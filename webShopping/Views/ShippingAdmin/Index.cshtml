@model webShopping.Models.ShippingSettings
@{
    ViewData["Title"] = Localizer["ShippingAdmin"];
    var zones = ViewBag.Zones as IEnumerable<webShopping.Models.ShippingZone> ?? Enumerable.Empty<webShopping.Models.ShippingZone>();
}

<div class="section-title mb-4"><i class="bi bi-truck"></i> @Localizer["ShippingAdmin"]</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="global-card p-4">
            <h5 class="fw-bold mb-3">@Localizer["ShippingSettings"]</h5>
            <form asp-action="SaveSettings" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div class="mb-3">
                    <label class="form-label">@Localizer["StoreCountry"]</label>
                    <input asp-for="StoreCountry" class="form-control" required />
                </div>
                <div class="mb-3">
                    <label class="form-label">@Localizer["StoreCity"]</label>
                    <input asp-for="StoreCity" class="form-control" required />
                </div>
                <div class="form-check mb-3">
                    <input asp-for="FreeShippingSameCity" class="form-check-input" />
                    <label class="form-check-label" asp-for="FreeShippingSameCity">@Localizer["FreeShippingSameCity"]</label>
                </div>
                <div class="mb-3">
                    <label class="form-label">@Localizer["FreeShippingMinOrder"] (USD)</label>
                    <input asp-for="FreeShippingMinOrderUsd" class="form-control" type="number" step="0.01" min="0" />
                    <small class="text-muted">@Localizer["FreeShippingMinOrderHint"]</small>
                </div>
                <hr />
                <div class="mb-3">
                    <label class="form-label">@Localizer["DefaultShippingCost"] (USD)</label>
                    <input asp-for="DefaultCostUsd" class="form-control" type="number" step="0.01" min="0" />
                </div>
                <div class="mb-3">
                    <label class="form-label">@Localizer["DefaultVatRate"]</label>
                    <input asp-for="DefaultVatRate" class="form-control" type="number" step="0.01" min="0" max="1" />
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label">@Localizer["DeliveryMinDays"]</label>
                        <input asp-for="DefaultMinDays" class="form-control" type="number" min="1" />
                    </div>
                    <div class="col-6">
                        <label class="form-label">@Localizer["DeliveryMaxDays"]</label>
                        <input asp-for="DefaultMaxDays" class="form-control" type="number" min="1" />
                    </div>
                </div>
                <button type="submit" class="btn btn-accent">@Localizer["Save"]</button>
            </form>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="global-card p-4 mb-4">
            <h5 class="fw-bold mb-3">@Localizer["AddShippingZone"]</h5>
            <form asp-action="AddZone" method="post">
                @Html.AntiForgeryToken()
                <div class="row g-2">
                    <div class="col-md-4">
                        <input name="Country" class="form-control" placeholder="@Localizer["Country"]" required />
                    </div>
                    <div class="col-md-4">
                        <input name="City" class="form-control" placeholder="@Localizer["CityOptional"]" />
                    </div>
                    <div class="col-md-4">
                        <input name="ShippingCostUsd" class="form-control" type="number" step="0.01" min="0" placeholder="@Localizer["CostUsd"]" required />
                    </div>
                    <div class="col-md-3">
                        <input name="VatRate" class="form-control" type="number" step="0.01" min="0" max="1" value="0" placeholder="VAT" />
                    </div>
                    <div class="col-md-3">
                        <input name="DeliveryMinDays" class="form-control" type="number" min="1" value="3" />
                    </div>
                    <div class="col-md-3">
                        <input name="DeliveryMaxDays" class="form-control" type="number" min="1" value="10" />
                    </div>
                    <div class="col-md-3">
                        <input name="SortOrder" class="form-control" type="number" value="0" />
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input name="IsFreeShipping" class="form-check-input" type="checkbox" value="true" />
                            <label class="form-check-label">@Localizer["FreeShipping"]</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-accent btn-sm"><i class="bi bi-plus-lg"></i> @Localizer["Add"]</button>
                    </div>
                </div>
            </form>
        </div>

        <div class="global-card">
            <div class="table-responsive">
                <table class="table global-table mb-0">
                    <thead>
                        <tr>
                            <th>@Localizer["Country"]</th>
                            <th>@Localizer["City"]</th>
                            <th>@Localizer["CostUsd"]</th>
                            <th>VAT</th>
                            <th>@Localizer["Delivery"]</th>
                            <th>@Localizer["Status"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var z in zones)
                        {
                            <tr>
                                <td>@z.Country</td>
                                <td>@(z.City ?? "—")</td>
                                <td>@(z.IsFreeShipping ? Localizer["FreeShipping"] : $"${z.ShippingCostUsd:F2}")</td>
                                <td>@(z.VatRate.ToString("P0"))</td>
                                <td>@z.DeliveryMinDays–@z.DeliveryMaxDays</td>
                                <td>
                                    <span class="badge @(z.IsActive ? "bg-success" : "bg-secondary")">
                                        @(z.IsActive ? Localizer["Active"] : Localizer["Inactive"])
                                    </span>
                                </td>
                                <td class="text-nowrap">
                                    <a asp-action="EditZone" asp-route-id="@z.Id" class="btn btn-sm btn-outline-primary">@Localizer["Edit"]</a>
                                    <form asp-action="DeleteZone" method="post" class="d-inline" onsubmit="return confirm('@Localizer["ConfirmDelete"]');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@z.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">@Localizer["Delete"]</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
