@model IEnumerable<webShopping.Models.Categoty>

<div class="col-md-3">
    <div class="category-sidebar">
        <div class="category-sidebar-header">
            <i class="bi bi-tags"></i> @Localizer["Categories"]
        </div>
        <div class="list-group list-group-flush">
            <a asp-action="Shop" asp-controller="Home"
               class="list-group-item list-group-item-action @(ViewBag.KategoryId == null ? "active" : "")">
                @Localizer["AllProducts"]
            </a>
            @foreach (var item in Model)
            {
                <a asp-action="Shop" asp-controller="Home"
                   class="list-group-item list-group-item-action @(ViewBag.KategoryId?.ToString() == item.Id.ToString() ? "active" : "")"
                   asp-route-categoryId="@item.Id">
                    @item.Name
                </a>
            }
        </div>
    </div>
</div>
