@model IEnumerable<webShopping.Models.ContactMessage>
@{
    ViewData["Title"] = Localizer["Messages"];
}
<div class="section-title mb-3"><i class="bi bi-envelope"></i> @Localizer["Messages"]</div>
<div class="admin-table-wrap global-card">
    <table class="table table-hover mb-0 global-table">
        <thead>
            <tr>
                <th>@Localizer["Name"]</th>
                <th>Email</th>
                <th>@Localizer["Subject"]</th>
                <th>@Localizer["Date"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
        @foreach (var item in Model)
        {
            <tr class="@(item.IsRead ? "" : "table-warning")">
                <td>@item.Name</td>
                <td>@item.Email</td>
                <td>@(string.IsNullOrEmpty(item.Subject) ? "—" : item.Subject)</td>
                <td>@item.CreatedAt.ToLocalTime().ToString("g")</td>
                <td class="text-end">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">@Localizer["Details"]</a>
                </td>
            </tr>
        }
        </tbody>
    </table>
</div>
