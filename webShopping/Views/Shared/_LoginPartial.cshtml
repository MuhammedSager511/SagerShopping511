@using Microsoft.AspNetCore.Identity
@using webShopping.Models
@inject SignInManager<ApplicationUser> SignInManager

<ul class="navbar-nav align-items-center gap-1">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <a class="nav-link text-white" asp-controller="Profile" asp-action="Index" title="@Localizer["MyAccount"]">
                <i class="bi bi-person-circle"></i> @Localizer["MyAccount"]
            </a>
        </li>
        <li class="nav-item">
            <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Action("Index", "Home")" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-light">
                    <i class="bi bi-box-arrow-right"></i> @Localizer["Logout"]
                </button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="btn btn-sm btn-outline-light me-1" asp-area="Identity" asp-page="/Account/Register">
                <i class="bi bi-person-plus"></i> @Localizer["Register"]
            </a>
        </li>
        <li class="nav-item">
            <a class="btn btn-sm btn-accent" asp-area="Identity" asp-page="/Account/Login">
                <i class="bi bi-box-arrow-in-right"></i> @Localizer["Login"]
            </a>
        </li>
    }
</ul>
